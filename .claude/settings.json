{
  "permissions": {
    "allow": [
      "Edit(/**)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin feat/*)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npm run check:*)",
      "Bash(npm run test:*)",
      "Bash(node tools/*)",
      "Bash(node tests/*)",
      "Bash(node api/*)",

      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git rev-list *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git check-ignore *)",
      "PowerShell(git fetch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push)",
      "PowerShell(git push origin feat/*)",
      "PowerShell(npm ci)",
      "PowerShell(npm test)",
      "PowerShell(npm run check)",
      "PowerShell(npm run check:*)",
      "PowerShell(npm run test:*)",
      "PowerShell(node tools/*)",
      "PowerShell(node tests/*)",
      "PowerShell(node api/*)"
    ],
    "deny": [
      "Edit(/.env*)",
      "Edit(/.git/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push origin main*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(Remove-Item * -Recurse*)"
    ]
  }
}
